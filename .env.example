# -----------------------------------------------------------------------------
# multirate-web env
# -----------------------------------------------------------------------------

# Base URL of the billing-api backend. Ignored when VITE_MOCK_API=true.
VITE_API_URL=http://localhost:4000

# When true, every /api/* call is served by an in-browser mock (see
# src/lib/mockApi.ts). Handy for demos, offline dev, and evaluators.
# State persists in localStorage under `billing.mock.db`.
# Seeded demo user: demo@example.com / password
VITE_MOCK_API=true
